<Window x:Class="AcoesRapidas.UI.TutorialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AcoesRapidas.UI"
        Title="Como usar a rodinha"
        Width="800"
        Height="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="FormStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20,18,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource Brush.Panel}" CornerRadius="10">
            <ui:WheelPreview x:Name="Preview"
                             Margin="6"
                             IsHitTestVisible="False"
                             Focusable="False"
                             AutomationProperties.Name="Exemplo da rodinha" />
        </Border>

        <StackPanel x:Name="StepPanel" Grid.Column="2">
            <TextBlock x:Name="StepCounter" Style="{StaticResource FieldHint}" Margin="0,2,0,4" />
            <TextBlock x:Name="StepTitle" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="StepBody" FontSize="14" LineHeight="21" TextWrapping="Wrap" Margin="0,10,0,16" />
            <Grid x:Name="KeysGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            </Grid>
        </StackPanel>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,16,0,0">
            <Button x:Name="NextButton"
                    DockPanel.Dock="Right"
                    Style="{StaticResource PrimaryButton}"
                    MinWidth="130"
                    Margin="8,0,0,0"
                    IsDefault="True"
                    Click="OnNext" />
            <Button x:Name="BackButton"
                    DockPanel.Dock="Right"
                    Style="{StaticResource GhostButton}"
                    Content="Voltar"
                    MinWidth="96"
                    Margin="8,0,0,0"
                    Click="OnBack" />
            <Button x:Name="SkipButton"
                    DockPanel.Dock="Right"
                    Style="{StaticResource GhostButton}"
                    Content="Pular tutorial"
                    Click="OnSkip" />
            <StackPanel x:Name="DotsPanel" Orientation="Horizontal" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>

<Window x:Class="AcoesRapidas.UI.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ações rápidas"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">
    <Grid x:Name="Root" Margin="18" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Shift" Y="14" />
        </Grid.RenderTransform>

        <Border x:Name="ShadowPlate" CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.3" Color="Black" />
            </Border.Effect>
        </Border>

        <Border x:Name="Card" BorderThickness="1" CornerRadius="10" MinWidth="260" MaxWidth="380">
            <Grid Margin="14,12,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Width="30" Height="30" VerticalAlignment="Top">
                    <Ellipse x:Name="IconDisc" />
                    <TextBlock x:Name="IconGlyph"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="15"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>

                <TextBlock x:Name="MessageText"
                           Grid.Column="1"
                           Margin="12,0,0,0"
                           MinHeight="30"
                           VerticalAlignment="Center"
                           Padding="0,6,0,0"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="13"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</Window>
